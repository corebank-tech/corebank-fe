# vite.config.ts의 로컬 백엔드 프록시(/api/v1 -> http://localhost:8080)는
# VITE_API_BASE_URL이 /api/v1일 때만 동작한다. 절대 URL(예: http://localhost:8080/api/v1)을
# 넣으면 프록시를 우회해 CORS 에러가 난다.
VITE_API_BASE_URL=/api/v1

# true로 켜면 MSW(mock service worker)가 API 요청을 가로채 mock 응답을 반환한다.
VITE_ENABLE_MSW=false

# 배포된 백엔드로 붙여 실 API 화면을 확인할 때는 dev 서버에 프록시 대상을 넘긴다.
# (VITE_ 접두사가 아니라 셸 환경변수다 — 이 파일이 아니라 명령줄에서 준다.)
#
#   API_PROXY_TARGET=https://api.corebank.cloud pnpm dev
#
# 브라우저는 localhost 로만 요청하므로 서버 CORS 허용 오리진이 아니어도 동작한다.
# 프록시가 Origin 헤더를 떼고, XSRF-TOKEN 쿠키의 Domain 을 지워 localhost 가 읽게 한다.
